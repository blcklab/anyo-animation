{
  "name": "@blcklab/anyo-animation",
  "version": "0.1.3",
  "description": "Optional renderer-neutral animation runtime for Anyo with parameters, state machines, events, root motion, authoring contracts, and an explicit Sekai64 adapter.",
  "keywords": [
    "anyo",
    "animation",
    "3d",
    "gltf",
    "glb",
    "sekai64",
    "state-machine",
    "spatial-web"
  ],
  "license": "MIT",
  "author": "blcklab",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./sekai64": {
      "types": "./dist/types/sekai64/index.d.ts",
      "import": "./dist/esm/sekai64/index.js"
    },
    "./package.json": "./package.json",
    "./authoring": {
      "types": "./dist/types/authoring/index.d.ts",
      "import": "./dist/esm/authoring/index.js",
      "require": "./dist/cjs/authoring/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "npm run generate:version && tsc -p tsconfig.check.json --noEmit --pretty false",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "size": "node scripts/size.mjs",
    "check": "npm run typecheck && npm run typecheck:examples && npm run test && npm run verify:boundaries && npm run verify:package && npm run verify:stable && npm run size && npm run test:consumer",
    "prepublishOnly": "npm run check",
    "generate:version": "node scripts/generate-version.mjs",
    "test:consumer": "node scripts/test-packed-consumer.mjs",
    "verify:stable": "node scripts/verify-stable.mjs",
    "typecheck:examples": "tsc -p tsconfig.examples.json --pretty false"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@blcklab/anyo": ">=0.9.1-0 <0.10.0 || >=0.10.0-0 <1.0.0",
    "@blcklab/sekai64": ">=0.8.0-0 <0.9.0"
  },
  "peerDependenciesMeta": {
    "@blcklab/sekai64": {
      "optional": true
    }
  },
  "devDependencies": {
    "@blcklab/anyo": "0.10.0-rc.3",
    "@blcklab/sekai64": "0.8.0-rc.34",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blcklab/anyo-animation.git"
  },
  "bugs": {
    "url": "https://github.com/blcklab/anyo-animation/issues"
  },
  "homepage": "https://github.com/blcklab/anyo-animation#readme"
}
